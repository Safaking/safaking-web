# ============================================================================
# SafaKing environment
# Copy to .env.local and fill in. Never commit .env.local.
# ============================================================================

# ---- Supabase (public: safe to expose, protected by RLS) -------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>

# ---- Supabase service role (SECRET) ----------------------------------------
# Dashboard -> Project Settings -> API -> service_role.
# Bypasses RLS. Used only by /api/checkout/* to price and write orders.
# NEVER prefix this NEXT_PUBLIC_ — that would ship it to every browser and
# hand anyone full read/write on the database.
SUPABASE_SERVICE_ROLE_KEY=<service_role key>

# ---- Razorpay --------------------------------------------------------------
# Dashboard -> Settings -> API Keys. Start with the rzp_test_ pair.
# The key id is sent to the browser by the server; the secret never leaves it.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=<key secret>

# ---- WhatsApp notifications (optional) -------------------------------------
# Without these the notification route formats the message but sends nothing.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
ADMIN_WHATSAPP_PHONE=919829012345
NEXT_PUBLIC_ADMIN_WHATSAPP_PHONE=919829012345
